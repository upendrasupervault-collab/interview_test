def calculation_based_on_civil_score(principal: float, civil_score: int) -> float:
    if civil_score > 750:
        rate = interest_rates["personal"] - 1.0  # Discount for good credit score
    else:
        rate = interest_rates["personal"]
    interest = (principal * rate * 1) / 100  # Assuming 1 year for simplicity
    return interest

@app.get("/interest-rate/{loan_type}")
def get_interest_rate(loan_type: str) -> float:
    
    return interest_rates.get(loan_type.lower(), 0.0)


